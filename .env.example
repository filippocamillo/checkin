# Supabase (progetto in regione UE)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lettura documenti
ANTHROPIC_API_KEY=

# URL pubblico dell'app, usato nei link per gli ospiti (su Vercel si può lasciare vuoto)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segreto per il job orario che importa i calendari iCal
CRON_SECRET=

# Videochiamata di riconoscimento: server TURN facoltativo ma consigliato,
# perché alcune reti mobili bloccano il collegamento diretto (es. Cloudflare Calls, Metered)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
